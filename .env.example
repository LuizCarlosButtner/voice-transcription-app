# Voice Transcription App - Environment Variables Template
# Chaves de API (lidas preferencialmente de variáveis de ambiente do sistema, ex: ~/.zshenv ou ~/.zshrc)

# Groq API Key (utilizada para STT Whisper-large-v3-turbo e LLM de tom/gramatica)
GROQ_API_KEY=sua_chave_groq_aqui

# Fallbacks opcionais (se configurados)
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# Configuracoes do Servidor Local e Aplicativo
PORT=8100
HOST=127.0.0.1
DEFAULT_LANGUAGE=pt
DEFAULT_TONE=verbatim
AUTO_PUNCTUATION=true
